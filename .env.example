# PI-Foundry Environment Variables
# Copy to .env and fill in your values.

# Relay URL (default: http://127.0.0.1:7401)
# PI_FOUNDRY_RELAY_URL=http://127.0.0.1:7401

# RAG service URL (default: http://127.0.0.1:7402)
# PI_FOUNDRY_RAG_URL=http://127.0.0.1:7402

# HMAC secret for command authentication.
# Must match .secret file in the pi-foundry repo root,
# and the authToken setting in the pi-bridge Foundry module.
# PI_FOUNDRY_SECRET=your-secret-here
